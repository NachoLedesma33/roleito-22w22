{
  "name": "roleito",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent AI RPG World Engine",
  "scripts": {
    "dev": "npm run dev:dm",
    "dev:dm": "npm run dev --workspace=apps/dm",
    "dev:renderer": "npm run dev --workspace=apps/renderer",
    "dev:backend": "cd backend && ..\\venv\\Scripts\\python.exe -m uvicorn main:app --port 8000 --reload",
    "dev:backend:ci": "cd backend && python -m uvicorn main:app --port 8000",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=apps/dm",
    "test:e2e": "playwright test"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "typescript-eslint": "^8.67.0"
  }
}
