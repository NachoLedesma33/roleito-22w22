# Copiar a .env y completar. NUNCA commitear .env: este repo es publico.

# --- Contacto ---------------------------------------------------------------
# Destinatario real. Sin esto no se envia correo (el mensaje igual se guarda).
ROLEITO_CONTACT_EMAIL=tu-correo@example.com
# Gmail: activar 2FA y generar una "contraseña de aplicacion" (no la del login).
ROLEITO_SMTP_HOST=smtp.gmail.com
ROLEITO_SMTP_PORT=587
ROLEITO_SMTP_USER=tu-correo@gmail.com
ROLEITO_SMTP_PASSWORD=contraseña-de-aplicacion
# Poner 1 solo cuando las cuatro variables anteriores esten cargadas.
ROLEITO_CONTACT_SMTP_ENABLED=0
# Envios por IP por hora (antispam, ademas del honeypot y el rate limit global).
ROLEITO_CONTACT_MAX_PER_HOUR=3

# Retencion del formulario: 90 dias, 30 si el mensaje se marco respondido.
# Los plazos viven en backend/contact_routes.py; cambiarlos es una decision legal.

# --- Assets privados ---------------------------------------------------------
# Secreto para firmar URLs de handouts (HMAC path+exp, 1 h). Si se deja vacio,
# el backend genera una clave local en data/asset_signing.key (no commitear).
# En produccion poner el mismo valor en todas las instancias del backend.
ROLEITO_ASSET_SIGNING_SECRET=
